{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "openclaw/*": ["/home/user/.npm-global/lib/node_modules/openclaw/dist/*"]
    }
  },
  "include": ["index.ts", "lib/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
