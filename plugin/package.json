{
  "name": "@kiagentkronos-cell/activewiki",
  "version": "1.1.3",
  "type": "module",
  "private": false,
  "description": "ActiveWiki MemoryCorpusSupplement plugin for OpenClaw — vector search + knowledge graph over a configurable wiki corpus",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "openclaw": "^2026.5.27",
    "typescript": "^6.0.3"
  },
  "openclaw": {
    "plugin": "./openclaw.plugin.json",
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "1.0"
    },
    "build": {
      "openclawVersion": "2026.5.22"
    }
  }
}
